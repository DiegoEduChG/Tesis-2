# backend/.env.ejemplo
#
# Plantilla de configuración. Copia este archivo como .env y completa
# los valores. El archivo .env NO debe subirse al repositorio: contiene
# credenciales.
#
# =====================================================================
# DESARROLLO (tu máquina)
# =====================================================================
# Deja S3_BUCKET y URL_PUBLICA vacías o comentadas. El sistema usará el
# disco local para el audio y construirá las URL sobre localhost, que es
# el comportamiento que ya conoces.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nampivoz
DB_USER=nampivoz_app
DB_PASSWORD=cambia-esta-clave

PORT=3000
JWT_SECRET=cadena-larga-y-aleatoria-distinta-en-cada-entorno

# =====================================================================
# DESPLIEGUE (instancia EC2)
# =====================================================================
# Descomenta y completa estas cuatro variables. Su sola presencia
# cambia el comportamiento del sistema:
#
#   S3_BUCKET definida  → el audio se guarda en S3 en lugar del disco.
#   URL_PUBLICA definida → las URL de audio apuntan a CloudFront.
#
# URL_PUBLICA se conoce recién después de crear la distribución de
# CloudFront, de modo que este archivo se completa en dos tiempos.

# NODE_ENV=production
# AWS_REGION=us-east-2
# S3_BUCKET=nampivoz-corpus-XXXXXX
# URL_PUBLICA=https://dXXXXXXXXXXXX.cloudfront.net
# ORIGEN_PERMITIDO=https://dXXXXXXXXXXXX.cloudfront.net

# =====================================================================
# NOTA SOBRE LAS CREDENCIALES DE AWS
# =====================================================================
# No se declaran aquí claves de acceso de AWS, y no deben declararse.
# La instancia EC2 obtiene permiso sobre S3 mediante un rol de IAM
# asociado a ella: el SDK lo toma automáticamente del servicio de
# metadatos de la instancia.
#
# Guardar una clave de acceso en un archivo del servidor sería una
# credencial permanente expuesta en disco; el rol entrega credenciales
# temporales que rotan solas.
